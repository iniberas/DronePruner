<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="apple_tree">
    <static>true</static>
    <link name="link">

      <visual name="visual">
        <pose degrees="true">0 0 0 90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://apple_tree/meshes/apple_tree.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="trunk_collision">
        <pose>0 0 1.0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>2.0</length>
          </cylinder>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>